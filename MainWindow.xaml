<Window x:Class="PastelNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PastelNotes.ViewModels"
        xmlns:views="clr-namespace:PastelNotes.Views"
        Title="Pastel Notes" Height="780" Width="1240" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="14" FontWeight="Medium"
        UseLayoutRounding="True"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <DataTemplate x:Key="NoteTemplate" DataType="{x:Type vm:NoteViewModel}">
            <Grid x:Name="NoteRoot" Margin="0,2">
                <Button Style="{StaticResource FlatButton}"
                        Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Border x:Name="Pill" CornerRadius="8" Padding="12,8" Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,28,0"/>
                            <TextBlock Text="{Binding UpdatedText}" FontSize="11" Margin="0,1,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Button>
                <Button x:Name="DelBtn" Style="{StaticResource IconButton}" Content="&#xE74D;"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0"
                        ToolTip="Delete note"
                        Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="NoteRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource HoverSoftBrush}"/>
                    <Setter TargetName="DelBtn" Property="Opacity" Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{Binding Folder.SoftBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="FolderTemplate" DataType="{x:Type vm:FolderViewModel}">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,0,0,12" Padding="0,0,0,2"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>

                    <Border x:Name="Header" Background="{Binding SoftBrush}" CornerRadius="12" Padding="8,8,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" Style="{StaticResource ArrowToggle}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>

                            <ToggleButton x:Name="ColorBtn" Grid.Column="1" Style="{StaticResource ColorDotToggle}"
                                          Background="{Binding Brush}" Margin="2,0,8,0"
                                          ToolTip="Change folder color"
                                          IsChecked="{Binding IsPaletteOpen, Mode=TwoWay}"/>

                            <Popup IsOpen="{Binding IsPaletteOpen, Mode=TwoWay}" StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=ColorBtn}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="None"
                                   Opened="Palette_Opened">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="10" Margin="10"
                                        Effect="{StaticResource SoftShadow}">
                                    <ItemsControl ItemsSource="{Binding Palette}" Width="200">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ColorDotButton}"
                                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="Bold" FontSize="14.5"
                                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                                           MouseLeftButtonDown="FolderName_MouseDown"/>
                                <TextBox x:Name="NameBox" Style="{StaticResource BlockInput}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource InputOverlayBrush}" FontSize="14.5" FontWeight="Bold"
                                         TextWrapping="NoWrap" Visibility="Collapsed"
                                         IsVisibleChanged="NameBox_IsVisibleChanged"
                                         LostFocus="NameBox_LostFocus"
                                         KeyDown="NameBox_KeyDown"/>
                            </Grid>

                            <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" Opacity="0">
                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Rename"
                                        Command="{Binding RenameCommand}"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New note"
                                        Command="{Binding DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete folder"
                                        Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="NotesHost" ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteTemplate}"
                                  Margin="6,4,6,6" Focusable="False" ClipToBounds="True">
                        <ItemsControl.LayoutTransform>
                            <ScaleTransform x:Name="NotesScale" ScaleY="1"/>
                        </ItemsControl.LayoutTransform>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsListShown}" Value="False">
                    <Setter TargetName="NotesHost" Property="Visibility" Value="Collapsed"/>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="NotesScale" Storyboard.TargetProperty="ScaleY"
                                                 From="0" To="1" Duration="0:0:0.24" FillBehavior="Stop">
                                    <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="NotesHost" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.24" FillBehavior="Stop"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsListCollapsing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="FolderCollapseAnim">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="NotesScale" Storyboard.TargetProperty="ScaleY"
                                                 To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="NotesHost" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="FolderCollapseAnim"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NameBox" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RailFolderTemplate" DataType="{x:Type vm:FolderViewModel}">
            <Button Style="{StaticResource FlatButton}" Margin="0,0,0,10" ToolTip="{Binding Name}"
                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Border Width="40" Height="40" CornerRadius="8" Background="{Binding Brush}">
                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource OnPastelBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Button>
        </DataTemplate>

        <Style x:Key="RailStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarOpen}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpandedSidebarStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="310" MinWidth="230" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" ClipToBounds="True">
            <Grid>

                <Grid Style="{StaticResource ExpandedSidebarStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,22,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pastel Notes" FontSize="21" FontWeight="Bold"/>
                            <TextBlock Text="pretty &amp; tidy notes" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ Folder"
                                Command="{Binding AddFolderCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE76B;"
                                Margin="8,0,0,0" ToolTip="Collapse sidebar (Ctrl+B)"
                                Command="{Binding ToggleSidebarCommand}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource FolderTemplate}"
                                      Margin="14,0,8,16" Focusable="False"/>
                    </ScrollViewer>

                    <Button Grid.Row="2" Style="{StaticResource PillButton}" Margin="14,4,14,16"
                            Command="{Binding ToggleThemeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding ThemeIcon}" Margin="0,1,10,0"/>
                            <TextBlock Text="{Binding ThemeLabel}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Style="{StaticResource RailStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Style="{StaticResource PillButton}" Content="&#xE700;"
                            FontFamily="{StaticResource IconFont}" FontSize="15" Padding="0"
                            Width="40" Height="40" Margin="0,18,0,0" HorizontalAlignment="Center"
                            ToolTip="Expand sidebar (Ctrl+B)"
                            Command="{Binding ToggleSidebarCommand}"/>

                    <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="&#xE710;"
                            FontFamily="{StaticResource IconFont}" FontSize="15" Padding="0"
                            Width="40" Height="40" Margin="0,10,0,0" HorizontalAlignment="Center"
                            ToolTip="New folder"
                            Command="{Binding AddFolderCommand}"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource RailFolderTemplate}"
                                      HorizontalAlignment="Center" Focusable="False"/>
                    </ScrollViewer>

                    <Button Grid.Row="3" Style="{StaticResource IconButton}" Content="{Binding ThemeIcon}"
                            FontSize="16" Width="40" Height="40" Margin="0,8,0,16" HorizontalAlignment="Center"
                            ToolTip="{Binding ThemeLabel}"
                            Command="{Binding ToggleThemeCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2">
            <StackPanel Style="{StaticResource EmptyStateStyle}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✿" FontSize="54" Foreground="{DynamicResource LavenderBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a note in the sidebar" FontSize="18" FontWeight="Bold" Margin="0,8,0,2"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="or create a new folder &amp; note" Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="40,26,40,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Background="{Binding SelectedNote.Folder.SoftBrush}" CornerRadius="6"
                                Padding="10,3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedNote.Folder.Name}" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <TextBox x:Name="TitleBox" Style="{StaticResource BlockInput}"
                                 Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="32" FontWeight="Bold" Margin="-2,4,0,0"
                                 KeyDown="TitleBox_KeyDown"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="Export .md"
                            VerticalAlignment="Top" Margin="12,6,0,0"
                            Command="{Binding ExportCommand}"/>
                </Grid>

                <views:NoteEditorView x:Name="EditorHost" Grid.Row="1" DataContext="{Binding Editor}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
