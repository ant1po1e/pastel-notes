<Window x:Class="PastelNotes.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Medium"
        Foreground="{StaticResource TextBrush}"
        KeyDown="Window_KeyDown">

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="24" Width="390" Background="White" CornerRadius="12" Padding="22,22,22,18"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#6B4E9B" Opacity="0.22"/>
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="8" Background="#F1E9FA"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText" FontFamily="{StaticResource IconFont}" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="#7A7490"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource PillButton}" Padding="18,9"
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource PillButton}" Padding="18,9"
                        Margin="0" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
