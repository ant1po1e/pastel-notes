<UserControl x:Class="PastelNotes.Views.NoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PastelNotes.ViewModels"
             xmlns:svc="clr-namespace:PastelNotes.Services"
             xmlns:ctl="clr-namespace:PastelNotes.Controls">

    <UserControl.Resources>

        <DataTemplate x:Key="TableCellTemplate" DataType="{x:Type vm:CellViewModel}">
            <Border x:Name="CellBorder" BorderThickness="0,0,1,1"
                    BorderBrush="{DynamicResource TableBorderBrush}" Background="Transparent">
                <TextBox x:Name="CellInput" Style="{StaticResource BlockInput}" IsUndoEnabled="False"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="8,6"
                         GotKeyboardFocus="Cell_GotFocus"
                         PreviewKeyDown="Cell_PreviewKeyDown"
                         PreviewMouseWheel="Block_PreviewMouseWheel"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
                    <Setter TargetName="CellInput" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TableRowTemplate" DataType="{x:Type vm:TableRowViewModel}">
            <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource TableCellTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>


        <DataTemplate x:Key="TextBody" DataType="{x:Type vm:BlockViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="Arrow" Style="{StaticResource ArrowToggle}"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              Visibility="Collapsed" VerticalAlignment="Top" Margin="0,6,0,0"/>

                <CheckBox x:Name="Check" Style="{StaticResource PastelCheck}"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Left"
                          Margin="2,7,0,0"/>

                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource BulletBrush}"
                         Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Left"
                         Margin="6,12,0,0"/>

                <Grid x:Name="TextHost" Grid.Column="1">
                    <TextBox x:Name="Input" Style="{StaticResource BlockInput}" IsUndoEnabled="False"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="Block_PreviewKeyDown"
                             PreviewMouseWheel="Block_PreviewMouseWheel"
                             GotKeyboardFocus="Block_GotFocus"
                             DataObject.Pasting="Block_Pasting">
                        <TextBox.Opacity>
                            <MultiBinding Converter="{StaticResource RenderedMode}" ConverterParameter="opacity">
                                <Binding Path="IsKeyboardFocusWithin" RelativeSource="{RelativeSource Self}"/>
                                <Binding Path="Text"/>
                                <Binding Path="Type"/>
                            </MultiBinding>
                        </TextBox.Opacity>
                    </TextBox>

                    <TextBlock x:Name="Display" TextWrapping="Wrap" Cursor="IBeam"
                               svc:InlineMarkdown.Source="{Binding Text}"
                               FontSize="{Binding FontSize, ElementName=Input}"
                               FontWeight="{Binding FontWeight, ElementName=Input}"
                               Foreground="{Binding Foreground, ElementName=Input}"
                               TextDecorations="{Binding TextDecorations, ElementName=Input}"
                               Margin="{Binding Padding, ElementName=Input}"
                               PreviewMouseLeftButtonDown="Display_PreviewMouseLeftButtonDown">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource RenderedMode}">
                                <Binding Path="IsKeyboardFocusWithin" ElementName="Input"/>
                                <Binding Path="Text"/>
                                <Binding Path="Type"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>

                <Border x:Name="ProgressPill" Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="6"
                        Padding="8,2" Margin="8,5,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="{Binding Progress}" FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Bullet">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Checklist">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Branch">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Input" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="ProgressPill" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Heading1">
                    <Setter TargetName="Input" Property="FontSize" Value="28"/>
                    <Setter TargetName="Input" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Heading2">
                    <Setter TargetName="Input" Property="FontSize" Value="21"/>
                    <Setter TargetName="Input" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Type}" Value="Checklist"/>
                        <Condition Binding="{Binding IsChecked}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Input" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    <Setter TargetName="Input" Property="TextDecorations" Value="Strikethrough"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CodeBody" DataType="{x:Type vm:BlockViewModel}">
            <StackPanel Margin="28,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Language" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <TextBox Style="{StaticResource BlockInput}" MinWidth="90" FontSize="12" TextWrapping="NoWrap"
                             Foreground="{DynamicResource MutedBrush}"
                             Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseWheel="Block_PreviewMouseWheel"/>
                </StackPanel>
                <TextBox x:Name="Input" Style="{StaticResource BlockInput}" IsUndoEnabled="False"
                         AcceptsReturn="True" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Normal"
                         Padding="12,10" Background="{DynamicResource CodeBgBrush}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="Block_PreviewKeyDown"
                         PreviewMouseWheel="Block_PreviewMouseWheel"
                         GotKeyboardFocus="Block_GotFocus"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ImageBody" DataType="{x:Type vm:BlockViewModel}">
            <StackPanel Margin="28,0,0,0">
                <Grid x:Name="PictureHost" HorizontalAlignment="Left" Margin="0,4,0,2">
                    <Image Source="{Binding ImageSource}" MaxHeight="460" Stretch="Uniform"
                           StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="MissingNote" Text="Image file is missing" Margin="4,8"
                               Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
                    <Border x:Name="RemoveChip" Background="{DynamicResource ImageChipBrush}" CornerRadius="6"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Opacity="0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Foreground="White"
                                Width="28" Height="28" ToolTip="Remove image" Click="ImageRemove_Click"/>
                    </Border>
                </Grid>
                <TextBox x:Name="Input" Style="{StaticResource BlockInput}" IsUndoEnabled="False"
                         FontSize="12.5" FontStyle="Italic" Foreground="{DynamicResource MutedBrush}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="Block_PreviewKeyDown"
                         PreviewMouseWheel="Block_PreviewMouseWheel"
                         GotKeyboardFocus="Block_GotFocus"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                    <Setter TargetName="MissingNote" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger SourceName="PictureHost" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveChip" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TableBody" DataType="{x:Type vm:BlockViewModel}">
            <StackPanel Margin="28,4,0,4">
                <Border BorderBrush="{DynamicResource TableBorderBrush}" BorderThickness="1,1,0,0">
                    <ItemsControl ItemsSource="{Binding Table.Rows}"
                                  ItemTemplate="{StaticResource TableRowTemplate}" Focusable="False"/>
                </Border>
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource PillButton}" Content="+ Row" ToolTip="Add row" FontSize="11.5" Padding="10,4"
                            Click="TableAddRow_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="+ Column" ToolTip="Add column" FontSize="11.5" Padding="10,4"
                            Click="TableAddColumn_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="- Row" ToolTip="Remove last row" FontSize="11.5" Padding="10,4"
                            Click="TableRemoveRow_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="- Column" ToolTip="Remove last column" FontSize="11.5" Padding="10,4"
                            Click="TableRemoveColumn_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="&#xE74D;" ToolTip="Delete table"
                            FontFamily="{StaticResource IconFont}" FontWeight="Normal" FontSize="12" Padding="10,5"
                            Click="TableDelete_Click"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="BodyStyle" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ContentTemplate" Value="{StaticResource TextBody}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="CodeBlock">
                    <Setter Property="ContentTemplate" Value="{StaticResource CodeBody}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Image">
                    <Setter Property="ContentTemplate" Value="{StaticResource ImageBody}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Table">
                    <Setter Property="ContentTemplate" Value="{StaticResource TableBody}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BlockTemplate" DataType="{x:Type vm:BlockViewModel}">
            <Grid x:Name="RowHost" Visibility="Collapsed">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="RowScale" ScaleY="1"/>
                </Grid.LayoutTransform>

                <Border x:Name="Row" Margin="{Binding IndentMargin}" CornerRadius="8" Padding="4,1"
                        Background="Transparent">
                    <ContentControl Content="{Binding}" Style="{StaticResource BodyStyle}"/>
                </Border>

                <ctl:IndentGuides IsHitTestVisible="False" Level="{Binding Level}" Mask="{Binding GuideMask}"
                                  HasChildren="{Binding HasChildren}" Step="26"
                                  Brush="{DynamicResource GuideBrush}"/>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowHost" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RowHost" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RowHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowHost" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <DataTrigger Binding="{Binding Type}" Value="Branch">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource LavenderSoftBrush}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource BlockSelectionBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ScrollHost" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRawMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="40,8,40,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <Button Style="{StaticResource ToolButton}" Content="&#xE8D2;" Tag="Text" ToolTip="Plain text" Click="TypeButton_Click"/>
            <Button Style="{StaticResource ToolTextButton}" Content="H1" Tag="Heading1" ToolTip="Heading 1" Click="TypeButton_Click"/>
            <Button Style="{StaticResource ToolTextButton}" Content="H2" Tag="Heading2" ToolTip="Heading 2" Click="TypeButton_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE8FD;" Tag="Bullet" ToolTip="Bullet list" Click="TypeButton_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE73A;" Tag="Checklist" ToolTip="Checklist" Click="TypeButton_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE76C;" Tag="Branch" ToolTip="Foldable branch" Click="TypeButton_Click"/>
            <Border Width="2" Height="20" Background="{DynamicResource LavenderSoftBrush}" CornerRadius="1"
                    Margin="4,8,10,8"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE943;" Tag="CodeBlock" ToolTip="Code block" Click="TypeButton_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE80A;" ToolTip="Insert table" Click="TableButton_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE91B;" ToolTip="Insert image" Click="ImageButton_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE71B;" ToolTip="Insert link (Ctrl+K)" Click="LinkButton_Click"/>
            <Border Width="2" Height="20" Background="{DynamicResource LavenderSoftBrush}" CornerRadius="1"
                    Margin="4,8,10,8"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE70E;" ToolTip="Collapse all branches" Click="CollapseAll_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="&#xE70D;" ToolTip="Expand all branches" Click="ExpandAll_Click"/>
            <ToggleButton Style="{StaticResource ToolToggle}" Content="MD" ToolTip="Markdown mode (edit raw text)"
                          IsChecked="{Binding IsRawMode, Mode=TwoWay}"/>
        </WrapPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="BlocksScroll" Style="{StaticResource ScrollHost}" Padding="20,16,12,16"
                              PreviewMouseLeftButtonDown="Blocks_PreviewMouseDown"
                              PreviewMouseMove="Blocks_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="Blocks_PreviewMouseUp">
                    <StackPanel>
                        <ItemsControl x:Name="BlocksList" ItemsSource="{Binding Blocks}"
                                      ItemTemplate="{StaticResource BlockTemplate}" Focusable="False"/>
                        <Border Background="Transparent" MinHeight="140" Cursor="IBeam"
                                MouseLeftButtonDown="EndArea_MouseDown"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBox x:Name="RawBox" Style="{StaticResource BlockInput}"
                         Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVis}}"
                         AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="{StaticResource MonoFont}" FontSize="13.5" FontWeight="Normal"
                         VerticalScrollBarVisibility="Auto" Margin="20,16,12,16"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="6,10,0,0" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                   Text="Enter: new line  ·  Tab / Shift+Tab: change level  ·  Alt+↑/↓: move line  ·  Ctrl+Enter: check / fold / exit code block  ·  Ctrl+K: link  ·  Ctrl+A twice: select all blocks  ·  Ctrl+Z / Ctrl+Y: undo / redo  ·  Type #, -, [], &gt; or ``` at the start of a line"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
