<UserControl x:Class="PastelNotes.Views.NoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PastelNotes.ViewModels">

    <UserControl.Resources>

        <DataTemplate x:Key="BlockTemplate" DataType="{x:Type vm:BlockViewModel}">
            <Border x:Name="Row" Margin="{Binding IndentMargin}" CornerRadius="6" Padding="4,1"
                    Background="Transparent"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="Arrow" Style="{StaticResource ArrowToggle}"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  Visibility="Collapsed" VerticalAlignment="Top" Margin="0,6,0,0"/>

                    <CheckBox x:Name="Check" Style="{StaticResource PastelCheck}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Left"
                              Margin="2,7,0,0"/>

                    <TextBlock x:Name="Dot" Text="●" FontSize="8" Foreground="{StaticResource LavenderBrush}"
                               Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="8,13,0,0"/>

                    <TextBox x:Name="Input" Grid.Column="1" Style="{StaticResource BlockInput}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="Block_PreviewKeyDown"
                             PreviewMouseWheel="Block_PreviewMouseWheel"
                             GotKeyboardFocus="Block_GotFocus"
                             DataObject.Pasting="Block_Pasting"/>

                    <Border x:Name="ProgressPill" Grid.Column="2" Background="White" CornerRadius="6"
                            Padding="8,2" Margin="8,5,0,0" VerticalAlignment="Top"
                            Visibility="Collapsed">
                        <TextBlock Text="{Binding Progress}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Bullet">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Checklist">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Branch">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource LavenderSoftBrush}"/>
                    <Setter TargetName="Input" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="ProgressPill" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Heading1">
                    <Setter TargetName="Input" Property="FontSize" Value="28"/>
                    <Setter TargetName="Input" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Heading2">
                    <Setter TargetName="Input" Property="FontSize" Value="21"/>
                    <Setter TargetName="Input" Property="FontWeight" Value="Bold"/>
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Type}" Value="Checklist"/>
                        <Condition Binding="{Binding IsChecked}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Input" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter TargetName="Input" Property="TextDecorations" Value="Strikethrough"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ScrollHost" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRawMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="40,8,40,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <Button Style="{StaticResource PillButton}" Content="Text" Tag="Text" Click="TypeButton_Click"/>
            <Button Style="{StaticResource PillButton}" Content="H1" Tag="Heading1" Click="TypeButton_Click"/>
            <Button Style="{StaticResource PillButton}" Content="H2" Tag="Heading2" Click="TypeButton_Click"/>
            <Button Style="{StaticResource PillButton}" Content="Bullet" Tag="Bullet" Click="TypeButton_Click"/>
            <Button Style="{StaticResource PillButton}" Content="Checklist" Tag="Checklist" Click="TypeButton_Click"/>
            <Button Style="{StaticResource PillButton}" Content="Branch" Tag="Branch" Click="TypeButton_Click"/>
            <Border Width="2" Height="18" Background="{StaticResource LavenderSoftBrush}" CornerRadius="1"
                    Margin="4,2,10,8"/>
            <Button Style="{StaticResource PillButton}" Content="Collapse all" Click="CollapseAll_Click"/>
            <Button Style="{StaticResource PillButton}" Content="Expand all" Click="ExpandAll_Click"/>
            <ToggleButton Style="{StaticResource PillToggle}" Content="Markdown mode"
                          IsChecked="{Binding IsRawMode, Mode=TwoWay}"/>
        </WrapPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12"
                Effect="{StaticResource SoftShadow}">
            <Grid>
                <ScrollViewer x:Name="BlocksScroll" Style="{StaticResource ScrollHost}" Padding="20,16,12,16">
                    <StackPanel>
                        <ItemsControl x:Name="BlocksList" ItemsSource="{Binding Blocks}"
                                      ItemTemplate="{StaticResource BlockTemplate}" Focusable="False"/>
                        <Border Background="Transparent" MinHeight="140" Cursor="IBeam"
                                MouseLeftButtonDown="EndArea_MouseDown"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBox x:Name="RawBox" Style="{StaticResource BlockInput}"
                         Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVis}}"
                         AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="{StaticResource MonoFont}" FontSize="13.5" FontWeight="Normal"
                         VerticalScrollBarVisibility="Auto" Margin="20,16,12,16"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="6,10,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                   Text="Enter: new line  ·  Tab / Shift+Tab: change level  ·  Alt+↑/↓: move line  ·  Ctrl+Enter: check / fold  ·  Type #, -, [] or &gt; at the start of a line"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
